# Supabase - from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# In Supabase Dashboard: Authentication > URL Configuration
# - Site URL: https://pickdaniel.com (prod) or http://localhost:3000 (dev)
# - Redirect URLs: https://pickdaniel.com/auth/callback and http://localhost:3000/auth/callback

# Google OAuth - enable in Supabase Dashboard: Authentication > Providers > Google
# Add Client ID and Secret there. In Google Cloud Console, add authorized redirect:
# https://YOUR_SUPABASE_REF.supabase.co/auth/v1/callback

# Optional: Comma-separated admin emails (e.g. admin@mail.strakejesuit.org)
NEXT_PUBLIC_ADMIN_EMAILS=
