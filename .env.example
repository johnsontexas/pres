# Google OAuth - Create credentials at https://console.developers.google.com/apis/credentials
# Add http://localhost:3000/api/auth/callback/google for dev, https://yourdomain.com/api/auth/callback/google for prod
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth - Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Optional: Comma-separated admin emails (e.g. admin@mail.strakejesuit.org)
NEXT_PUBLIC_ADMIN_EMAILS=
